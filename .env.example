# Copy to .env.local and fill in. These override the defaults in config/site.ts.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_WHATSAPP=2547XXXXXXXX        # international format, digits only
NEXT_PUBLIC_TELEGRAM=your_username       # without @
NEXT_PUBLIC_EMAIL=you@example.com
NEXT_PUBLIC_INSTAGRAM=your_username
NEXT_PUBLIC_GITHUB=your_username
NEXT_PUBLIC_LINKEDIN=your-profile-slug   # the part after linkedin.com/in/
NEXT_PUBLIC_X=                           # optional
